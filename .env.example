# Axon AI Gateway Environment Variables
# Copy this file to .env and update the values

# Encryption Key (32+ character string for AES-256 encryption)
# Used to encrypt provider API keys in the database
# Generate a new one with: node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"
ENCRYPTION_KEY=your-secure-encryption-key-here

# Database Path (optional, defaults to ./data/gateway.db)
# DATABASE_PATH=./data/gateway.db

# Port (optional, defaults to 8787)
# PORT=8787

# Environment (optional, defaults to development)
# ENVIRONMENT=production

# Log Level (optional: debug, info, warn, error)
# LOG_LEVEL=info
